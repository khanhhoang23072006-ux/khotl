# Worker xử lý tài liệu: cần poppler (pdftoppm, pdftotext, pdfinfo), unzip
# và LibreOffice để chuyển DOCX/PPTX/XLSX sang PDF.
FROM node:22-bookworm-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    ca-certificates \
    poppler-utils \
    unzip \
    libreoffice-writer-nogui \
    libreoffice-impress-nogui \
    libreoffice-calc-nogui \
    fonts-dejavu-core \
    fonts-noto-core \
  && rm -rf /var/lib/apt/lists/*

RUN corepack enable
WORKDIR /app
COPY . .
RUN pnpm install --frozen-lockfile \
  && pnpm --filter @khotl/db generate

ENV NODE_ENV=production
# Cùng image này chạy migration và seed: docker compose run --rm migrate
CMD ["pnpm", "--filter", "@khotl/worker", "start"]
