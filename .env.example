# Sao chép thành .env ở thư mục gốc: cp .env.example .env
# Cả web, worker và Prisma đều đọc file .env ở thư mục gốc này.

# ---------------------------------------------------------------
# Chung
# ---------------------------------------------------------------
APP_URL=http://localhost:3000

# ---------------------------------------------------------------
# Cơ sở dữ liệu (Postgres 16 có pgvector, unaccent, pg_trgm)
# ---------------------------------------------------------------
DATABASE_URL=postgresql://khotl:khotl@localhost:5432/khotl

# ---------------------------------------------------------------
# Đăng nhập (Better Auth)
# ---------------------------------------------------------------
# Tạo bằng: openssl rand -base64 32
BETTER_AUTH_SECRET=thay-bang-chuoi-ngau-nhien-it-nhat-32-ky-tu
BETTER_AUTH_URL=http://localhost:3000
# Chỉ email thuộc các domain này mới tạo được tài khoản
ALLOWED_EMAIL_DOMAINS=sis.hust.edu.vn,hust.edu.vn
# Email được cấp quyền admin ngay khi đăng nhập lần đầu (phân tách bằng dấu phẩy)
ADMIN_EMAILS=
# Đăng nhập Microsoft (để trống thì ẩn nút Microsoft, chỉ dùng mã OTP)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Tenant ID của HUST; "organizations" cho phép mọi tenant (vẫn bị chặn theo domain email)
MICROSOFT_TENANT_ID=organizations

# ---------------------------------------------------------------
# Lưu file (S3 API: SeaweedFS khi dev/self-host, Cloudflare R2 khi cloud)
# ---------------------------------------------------------------
S3_ENDPOINT=http://localhost:8333
# Địa chỉ trình duyệt dùng để upload/tải trực tiếp (thường giống S3_ENDPOINT)
S3_PUBLIC_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=khotl
S3_ACCESS_KEY_ID=khotl
S3_SECRET_ACCESS_KEY=khotl-secret
S3_FORCE_PATH_STYLE=true

# ---------------------------------------------------------------
# Email (Mailpit khi dev: xem thư tại http://localhost:8025)
# ---------------------------------------------------------------
SMTP_URL=smtp://localhost:1025
MAIL_FROM=Kho tài liệu HUST <no-reply@khotl.local>

# ---------------------------------------------------------------
# Redis cho rate limit (để trống: dùng bộ nhớ trong tiến trình, chỉ hợp khi dev)
# ---------------------------------------------------------------
REDIS_URL=

# ---------------------------------------------------------------
# Worker
# ---------------------------------------------------------------
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
# true: không quét được virus thì từ chối file (bật khi chạy thật)
CLAMAV_REQUIRED=false
WORKER_CONCURRENCY=2

# ---------------------------------------------------------------
# Giới hạn (mặc định, admin chỉnh được sau)
# ---------------------------------------------------------------
UPLOAD_MAX_MB=50
UPLOAD_ZIP_MAX_MB=100
GUEST_PREVIEW_PAGES=3

# ---------------------------------------------------------------
# Dữ liệu mẫu: tạo sẵn tài khoản sinh viên, kiểm duyệt viên, admin để demo
# ---------------------------------------------------------------
SEED_DEMO_USERS=true
