{
  "name": "Kho tài liệu HUST",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "hostRequirements": { "cpus": 4, "memory": "8gb" },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postAttachCommand": "bash .devcontainer/start.sh",
  "forwardPorts": [3000, 8025],
  "portsAttributes": {
    "3000": { "label": "Web", "onAutoForward": "openBrowser" },
    "8025": { "label": "Hộp thư (mã đăng nhập)", "onAutoForward": "notify" },
    "5432": { "onAutoForward": "ignore" },
    "8333": { "onAutoForward": "ignore" },
    "6379": { "onAutoForward": "ignore" },
    "1025": { "onAutoForward": "ignore" }
  },
  "customizations": {
    "codespaces": { "openFiles": ["README.md"] }
  }
}
